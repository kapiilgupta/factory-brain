# Factory Brain API — Environment Variables Template
# Copy this file, rename it to .env, and fill in your real values
# NEVER commit .env to GitHub

PORT=4000
NODE_ENV=development

# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/factory-brain

# Use a long random string — minimum 32 characters
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# 7 days in milliseconds
COOKIE_MAX_AGE=604800000

# Your Next.js frontend URL
CLIENT_ORIGIN=http://localhost:3000
